# Balochistan Property Portal — copy to .env.local and fill in.
# Without these the site serves the bundled seed data (works out of the box).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only needed when building for GitHub Pages project URL.
# The GitHub Actions workflow sets this automatically — leave empty locally.
# NEXT_PUBLIC_BASE_PATH=/quetta-digital-property
